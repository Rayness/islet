<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Islet</RootNamespace>
    <AssemblyName>Islet</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Без MSIX: обычный exe, который можно положить куда угодно и запустить. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets\islet.ico</ApplicationIcon>
    <!-- Язык по умолчанию: на него падаем, если языка системы в ресурсах нет. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Свой Main (Program.cs): второй запуск пересылает команду первому ещё до WinUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Встроенные плагины лежат рядом с exe и обновляются вместе с приложением. -->
    <Content Include="..\..\plugins\**" Link="plugins\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PRIResource Include="Strings\**\*.resw" />
  </ItemGroup>

  <!-- dotnet publish не переносит PRI приложения рядом с exe, а без него WinUI не находит
       скомпилированный XAML и окно падает на запуске. Дописываем файл в список публикуемого. -->
  <Target Name="PublishProjectPri" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             RelativePath="$(ProjectPriFileName)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.12" />
    <!-- Только описания эффектов для стекла (маска по форме островка). -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- DPAPI: токены Kawaki на диске зашифрованы ключом текущего пользователя Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
