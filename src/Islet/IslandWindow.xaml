<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Islet.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:search="using:Islet.Search"
    xmlns:core="using:Islet.Core"
    Title="Islet">

    <!-- Окно прозрачное: видна только пилюля. -->
    <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent">
        <Grid.Resources>
            <!-- Палитра «Глубина» из DESIGN.md сайта. -->
            <SolidColorBrush x:Key="IslandSurfaceBrush" Color="#F5060B0F" />
            <SolidColorBrush x:Key="IslandEdgeBrush" Color="#333BE5CE" />
            <SolidColorBrush x:Key="IslandForegroundBrush" Color="#E8F1F0" />
            <SolidColorBrush x:Key="IslandMutedBrush" Color="#8FA3A8" />
            <SolidColorBrush x:Key="IslandFieldBrush" Color="#FF0F1C24" />
            <SolidColorBrush x:Key="IslandAccentBrush" Color="#3BE5CE" />
            <SolidColorBrush x:Key="IslandAccentSoftBrush" Color="#263BE5CE" />
            <SolidColorBrush x:Key="IslandCardBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="IslandWarnBrush" Color="#FFB454" />

            <Style x:Key="IslandIconButton" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="IslandSmallButton" TargetType="Button" BasedOn="{StaticResource IslandIconButton}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

        </Grid.Resources>

        <Border
            x:Name="Pill"
            Width="160"
            Height="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{StaticResource IslandSurfaceBrush}"
            BackgroundSizing="OuterBorderEdge"
            BorderBrush="{StaticResource IslandEdgeBrush}"
            BorderThickness="1"
            CornerRadius="4">

            <!-- Слои лежат друг на друге; виден тот, что соответствует состоянию капсулы.
                 Ширина каждого фиксирована: пока капсула растёт, содержимое не переливается,
                 а открывается из центра (отступы считает ApplyPill). -->
            <Grid x:Name="PillContent">

                <!-- ============ Живая капсула: музыка, таймер, прогресс плагина ============ -->
                <Grid
                    x:Name="CompactLayer"
                    Height="30"
                    Padding="6,0,10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ColumnSpacing="8"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.16" />
                    </Grid.OpacityTransition>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                        <FontIcon x:Name="CompactGlyph" FontSize="13" Foreground="{StaticResource IslandAccentBrush}" Glyph="&#xE916;" />
                        <Border x:Name="CompactArt" CornerRadius="5">
                            <Border.Background>
                                <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <TextBlock
                        x:Name="CompactText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IslandForegroundBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        x:Name="Equalizer"
                        Grid.Column="2"
                        Height="12"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Rectangle x:Name="EqBar1" Width="3" Height="12" Fill="{StaticResource IslandAccentBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="EqBar2" Width="3" Height="12" Fill="{StaticResource IslandAccentBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.9" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="EqBar3" Width="3" Height="12" Fill="{StaticResource IslandAccentBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.5" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="EqBar4" Width="3" Height="12" Fill="{StaticResource IslandAccentBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.7" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>

                    <!-- Прогресс активности тонкой полоской у нижнего края. -->
                    <Grid
                        x:Name="CompactProgressTrack"
                        Grid.ColumnSpan="3"
                        Height="2"
                        Margin="8,0,4,3"
                        VerticalAlignment="Bottom"
                        CornerRadius="1"
                        Background="#1FFFFFFF">
                        <Rectangle x:Name="CompactProgress" HorizontalAlignment="Left" Fill="{StaticResource IslandAccentBrush}" RadiusX="1" RadiusY="1" Width="0" />
                    </Grid>
                </Grid>

                <!-- ============ Пик уведомления ============ -->
                <Grid
                    x:Name="PeekLayer"
                    Height="58"
                    Padding="11,0,9,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    ColumnSpacing="11"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Tapped="PeekLayer_Tapped">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.18" />
                    </Grid.OpacityTransition>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                        <Border CornerRadius="11" Background="{StaticResource IslandAccentSoftBrush}" />
                        <FontIcon x:Name="PeekGlyph" FontSize="17" Foreground="{StaticResource IslandAccentBrush}" Glyph="&#xEA8F;" />
                        <Border x:Name="PeekImage" CornerRadius="11">
                            <Border.Background>
                                <ImageBrush x:Name="PeekImageBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PeekTitle"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource IslandForegroundBrush}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="PeekSource"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource IslandMutedBrush}" />
                        </Grid>
                        <!-- Текст не режется многоточием: уведомление — одно предложение, и обрезанное
                             оно теряет ровно то, ради чего пришло. Не влез — едет бегущей строкой. -->
                        <!-- Canvas не ограничивает ширину текста, а рамку режет Clip хоста. -->
                        <Grid x:Name="PeekBodyHost" Height="17" SizeChanged="PeekBodyHost_SizeChanged">
                            <Canvas>
                                <TextBlock
                                    x:Name="PeekBody"
                                    FontSize="12"
                                    Foreground="{StaticResource IslandMutedBrush}"
                                    TextWrapping="NoWrap">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="PeekBodyShift" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </Grid>
                    </StackPanel>

                    <Button
                        x:Name="PeekClose"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="PeekClose_Click"
                        Style="{StaticResource IslandSmallButton}">
                        <FontIcon FontSize="11" Foreground="{StaticResource IslandMutedBrush}" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <!-- ============ Раскрытый островок ============ -->
                <Grid
                    x:Name="Panel"
                    Width="678"
                    Padding="10,0,10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.14" />
                    </Grid.OpacityTransition>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="PinsPanel"
                            Orientation="Horizontal"
                            Spacing="2"
                            VerticalAlignment="Center" />

                        <Grid Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center">
                            <TextBox
                                x:Name="SearchBox"
                                x:Uid="SearchBox"
                                Background="{StaticResource IslandFieldBrush}"
                                BorderThickness="0"
                                CornerRadius="16"
                                IsSpellCheckEnabled="False"
                                Padding="14,6,10,6"
                                GotFocus="SearchBox_GotFocus"
                                PreviewKeyDown="SearchBox_PreviewKeyDown"
                                TextChanged="SearchBox_TextChanged">
                                <TextBox.Resources>
                                    <!-- Без полоски снизу при фокусе: у круглого поля она обрезается. -->
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF132530" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF132530" />
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Горячая клавиша прямо в строке, как «Ctrl Q» у Kawaki: сочетание, о котором
                                 негде узнать, всё равно что его отсутствие. Прячется, как только начали печатать. -->
                            <Border
                                x:Name="HotkeyHint"
                                Margin="0,0,9,0"
                                Padding="6,1,6,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                BorderBrush="#2EFFFFFF"
                                BorderThickness="1"
                                CornerRadius="5"
                                IsHitTestVisible="False">
                                <TextBlock x:Name="HotkeyHintText" FontSize="10" Foreground="{StaticResource IslandMutedBrush}" />
                            </Border>

                            <!-- Область поиска: «k » превращается в чип «Kawaki», Backspace его снимает. -->
                            <Border
                                x:Name="ScopeChip"
                                Margin="6,0,0,0"
                                Padding="8,3,9,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource IslandAccentSoftBrush}"
                                CornerRadius="11"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="ScopeGlyph" FontSize="11" Foreground="{StaticResource IslandAccentBrush}" />
                                    <TextBlock x:Name="ScopeText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IslandAccentBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Идущая активность (таймер) — чипом рядом с часами. -->
                        <Button
                            x:Name="ActivityChip"
                            Grid.Column="2"
                            Height="30"
                            Padding="10,0,12,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource IslandAccentSoftBrush}"
                            BorderThickness="0"
                            Click="ActivityChip_Click"
                            CornerRadius="15"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="ActivityChipGlyph" FontSize="12" Foreground="{StaticResource IslandAccentBrush}" Glyph="&#xE916;" />
                                <TextBlock x:Name="ActivityChipText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IslandAccentBrush}" />
                            </StackPanel>
                        </Button>

                        <TextBlock
                            x:Name="ClockText"
                            Grid.Column="3"
                            Margin="4,0,2,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource IslandForegroundBrush}" />

                        <!-- Колокол: всё, что приходило пиком, и счётчик непрочитанного. -->
                        <Button
                            x:Name="BellButton"
                            Grid.Column="4"
                            Click="BellButton_Click"
                            Style="{StaticResource IslandIconButton}">
                            <Grid>
                                <FontIcon x:Name="BellGlyph" FontSize="16" Glyph="&#xEA8F;" />
                                <Border
                                    x:Name="BellBadge"
                                    MinWidth="15"
                                    Height="15"
                                    Margin="0,-9,-11,0"
                                    Padding="4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource IslandAccentBrush}"
                                    CornerRadius="7.5"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="BellCount"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#06121A" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="MenuButton"
                            Grid.Column="5"
                            Style="{StaticResource IslandIconButton}">
                            <FontIcon FontSize="16" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout
                                    x:Name="MainMenu"
                                    Placement="BottomEdgeAlignedRight"
                                    ShouldConstrainToRootBounds="False">
                                    <MenuFlyoutItem x:Uid="MenuSettings" Click="Settings_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE713;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="MenuPlugins" Click="Plugins_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEA86;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="MenuHelp" Click="Help_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE897;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="HotkeyInfo" IsEnabled="False" />
                                    <MenuFlyoutItem x:Uid="MenuExit" Click="Exit_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8BB;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- ============ Сейчас играет ============ -->
                    <Border
                        x:Name="MediaCard"
                        Grid.Row="1"
                        Height="64"
                        Margin="0,0,0,8"
                        Padding="8,8,10,8"
                        Background="{StaticResource IslandCardBrush}"
                        CornerRadius="16"
                        Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="48" Height="48">
                                <Border CornerRadius="11" Background="{StaticResource IslandAccentSoftBrush}" />
                                <FontIcon FontSize="20" Foreground="{StaticResource IslandAccentBrush}" Glyph="&#xE8D6;" />
                                <Border x:Name="MediaArt" CornerRadius="11">
                                    <Border.Background>
                                        <ImageBrush x:Name="MediaArtBrush" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    x:Name="MediaTitle"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource IslandForegroundBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="MediaArtist"
                                    FontSize="12"
                                    Foreground="{StaticResource IslandMutedBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <Grid
                                    x:Name="MediaProgressTrack"
                                    Height="3"
                                    Margin="0,5,0,0"
                                    Background="#1FFFFFFF"
                                    CornerRadius="1.5">
                                    <Rectangle x:Name="MediaProgress" Width="0" HorizontalAlignment="Left" Fill="{StaticResource IslandAccentBrush}" RadiusX="1.5" RadiusY="1.5" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                                <Button x:Name="MediaPrev" Click="MediaPrev_Click" Style="{StaticResource IslandIconButton}">
                                    <FontIcon FontSize="14" Glyph="&#xE892;" />
                                </Button>
                                <Button x:Name="MediaPlay" Click="MediaPlay_Click" Style="{StaticResource IslandIconButton}" Background="{StaticResource IslandAccentSoftBrush}">
                                    <FontIcon x:Name="MediaPlayGlyph" FontSize="15" Foreground="{StaticResource IslandAccentBrush}" Glyph="&#xE769;" />
                                </Button>
                                <Button x:Name="MediaNext" Click="MediaNext_Click" Style="{StaticResource IslandIconButton}">
                                    <FontIcon FontSize="14" Glyph="&#xE893;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Заголовок колокола. -->
                    <Grid x:Name="NotificationsHeader" Grid.Row="2" Height="30" Padding="6,0,0,0" Visibility="Collapsed">
                        <TextBlock
                            x:Uid="NotificationsTitle"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource IslandMutedBrush}" />
                        <HyperlinkButton
                            x:Name="ClearNotificationsButton"
                            x:Uid="ClearNotificationsButton"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="ClearNotifications_Click"
                            FontSize="12" />
                    </Grid>

                    <ListView
                        x:Name="ResultsList"
                        Grid.Row="3"
                        Margin="-4,0,-4,10"
                        IsItemClickEnabled="True"
                        ItemClick="ResultsList_ItemClick"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectionMode="Single">
                        <!-- Встроенные анимации добавления/удаления строк и давали мигание на каждой букве. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Height" Value="52" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="CornerRadius" Value="14" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="search:ResultItem">
                                <Grid ColumnSpacing="12" Background="Transparent" ContextRequested="Result_ContextRequested">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontSize="20"
                                        Foreground="{StaticResource IslandMutedBrush}"
                                        Glyph="{x:Bind Glyph}"
                                        Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                    <Border Width="28" Height="28" CornerRadius="6">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            Foreground="{StaticResource IslandForegroundBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource IslandMutedBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind Subtitle, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        MaxWidth="180"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource IslandMutedBrush}"
                                        MaxLines="1"
                                        Opacity="0.8"
                                        Text="{x:Bind Trailing}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind TrailingVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView
                        x:Name="NotificationsList"
                        Grid.Row="3"
                        Margin="-4,0,-4,10"
                        IsItemClickEnabled="True"
                        ItemClick="NotificationsList_ItemClick"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectionMode="Single"
                        Visibility="Collapsed">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Height" Value="56" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="CornerRadius" Value="14" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:NotificationRow">
                                <Grid ColumnSpacing="12" Background="Transparent" ContextRequested="Notification_ContextRequested">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32">
                                        <Border CornerRadius="9" Background="{StaticResource IslandAccentSoftBrush}" />
                                        <FontIcon
                                            FontSize="15"
                                            Foreground="{StaticResource IslandAccentBrush}"
                                            Glyph="{x:Bind Glyph}"
                                            Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                        <Border CornerRadius="9">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            Margin="0,-2,-2,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Fill="{StaticResource IslandAccentBrush}"
                                            Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource IslandForegroundBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource IslandMutedBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind Body}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource IslandMutedBrush}"
                                        Opacity="0.8"
                                        Text="{x:Bind Meta}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="NotificationsEmpty"
                        x:Uid="NotificationsEmpty"
                        Grid.Row="3"
                        Margin="6,4,6,18"
                        VerticalAlignment="Top"
                        FontSize="13"
                        Foreground="{StaticResource IslandMutedBrush}"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
