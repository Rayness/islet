<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Islet.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Акцент — аква сайта, а не системный цвет пользователя. -->
            <Color x:Key="SystemAccentColor">#3BE5CE</Color>
            <Color x:Key="SystemAccentColorLight1">#62EAD8</Color>
            <Color x:Key="SystemAccentColorLight2">#8AF0E2</Color>
            <Color x:Key="SystemAccentColorLight3">#B1F5EC</Color>
            <Color x:Key="SystemAccentColorDark1">#2CC4B0</Color>
            <Color x:Key="SystemAccentColorDark2">#22A392</Color>
            <Color x:Key="SystemAccentColorDark3">#198174</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
