<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Islet.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Islet — настройки">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        IsTabStop="True"
        Loaded="Root_Loaded"
        PreviewKeyDown="Root_PreviewKeyDown"
        RequestedTheme="Dark"
        UseSystemFocusVisuals="False">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,2" />
            </Style>
            <Style x:Key="PageStack" TargetType="StackPanel">
                <Setter Property="Spacing" Value="6" />
                <Setter Property="Padding" Value="36,8,36,36" />
                <Setter Property="MaxWidth" Value="900" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Свой заголовок окна: иконка и название, остальное — системные кнопки. -->
        <StackPanel
            x:Name="TitleBar"
            Padding="16,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <Image Width="18" Height="18" Source="ms-appx:///Assets/islet.ico" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Text="Islet — настройки" />
        </StackPanel>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Общие" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Внешний вид" Tag="look">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Поиск" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Кнопки" Tag="pins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE718;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="О программе" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- ============ Общие ============ -->
                <ScrollViewer x:Name="GeneralPage">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Общие" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Горячая клавиша" />
                                    <TextBlock
                                        x:Name="HotkeyStatusText"
                                        Style="{StaticResource CardHint}"
                                        Text="Раскрывает островок с курсором в поиске" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Border
                                        Padding="10,5"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <TextBlock x:Name="HotkeyText" FontFamily="Consolas" />
                                    </Border>
                                    <Button x:Name="HotkeyButton" Click="HotkeyButton_Click" Content="Изменить" />
                                    <Button
                                        x:Name="HotkeyResetButton"
                                        Click="HotkeyResetButton_Click"
                                        ToolTipService.ToolTip="По умолчанию: Ctrl + Alt + Пробел">
                                        <FontIcon FontSize="14" Glyph="&#xE777;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Запускать вместе с Windows" />
                                    <TextBlock Style="{StaticResource CardHint}" Text="Островок появится сразу после входа в систему" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoStartToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="AutoStartToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Поиск в интернете" />
                                    <TextBlock Style="{StaticResource CardHint}" Text="Последняя строка выдачи открывает этот поисковик" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="EngineCombo"
                                    Grid.Column="1"
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Title"
                                    SelectionChanged="EngineCombo_SelectionChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Внешний вид ============ -->
                <ScrollViewer x:Name="LookPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Внешний вид" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Стекло" />
                                    <TextBlock Style="{StaticResource CardHint}" Text="Размытый рабочий стол под островком, как на сайте. Нужны включённые «Эффекты прозрачности» в Windows." />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="GlassToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="GlassToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Плотность фона" />
                                    <TextBlock
                                        x:Name="OpacityValue"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardHint}" />
                                </Grid>
                                <TextBlock Style="{StaticResource CardHint}" Text="Меньше — прозрачнее. Без стекла фон не бывает жиже 90%, иначе текст теряется." />
                                <Slider
                                    x:Name="OpacitySlider"
                                    Maximum="100"
                                    Minimum="20"
                                    StepFrequency="1"
                                    ValueChanged="OpacitySlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Ширина островка" />
                                    <TextBlock
                                        x:Name="WidthValue"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardHint}" />
                                </Grid>
                                <Slider
                                    x:Name="WidthSlider"
                                    Maximum="960"
                                    Minimum="560"
                                    StepFrequency="20"
                                    ValueChanged="WidthSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardTitle}"
                                    Text="Показывать часы" />
                                <ToggleSwitch
                                    x:Name="ClockToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="ClockToggle_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Поиск ============ -->
                <ScrollViewer x:Name="SearchPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Поиск" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Искать на других дисках" />
                                    <TextBlock Style="{StaticResource CardHint}" Text="Индекс Windows по умолчанию видит только папки пользователя на системном диске. Островок сам индексирует имена файлов в папках ниже." />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="IndexToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="IndexToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Состояние индекса" />
                                    <TextBlock x:Name="IndexStatusText" Style="{StaticResource CardHint}" />
                                </StackPanel>
                                <Button
                                    x:Name="RescanButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="RescanButton_Click"
                                    Content="Переиндексировать" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="Папки и диски" />
                        <StackPanel x:Name="RootsPanel" Spacing="6" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="AddRoot_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock Text="Добавить папку" />
                                </StackPanel>
                            </Button>
                            <Button Click="ResetRoots_Click" Content="Все диски, кроме системного" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Section}" Text="Не заходить в папки" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource CardHint}" Text="По одному имени в строке. Папка с таким именем пропускается на любой глубине — например node_modules." />
                                <TextBox
                                    x:Name="ExcludesBox"
                                    MinHeight="120"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    TextWrapping="NoWrap" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="SaveExcludes_Click"
                                    Content="Сохранить и переиндексировать"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" Text="Системный диск" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CardHint}" Text="Файлы на системном диске ищутся через индекс Windows. Чтобы он видел весь диск, включите «Расширенный» режим в параметрах поиска Windows." />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="OpenWindowsSearch_Click"
                                    Content="Открыть параметры" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Кнопки ============ -->
                <ScrollViewer x:Name="PinsPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Кнопки" />
                        <TextBlock Style="{StaticResource CardHint}" Text="Кнопки слева от поиска, до шести. Приложения из Microsoft Store удобнее закреплять из выдачи: правый клик → «Закрепить на островке»." />

                        <StackPanel x:Name="PinsList" Margin="0,8,0,0" Spacing="6" />

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddPinButton" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock Text="Добавить" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Click="AddPinFile_Click" Text="Программу или файл…">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="AddPinFolder_Click" Text="Папку…">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="AddPinUrl_Click" Text="Ссылку…">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE71B;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Click="ResetPins_Click" Content="Вернуть стандартные" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ О программе ============ -->
                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" Text="О программе" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Image Width="48" Height="48" Source="ms-appx:///Assets/islet.ico" />
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Islet" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource CardHint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Папка данных" />
                                    <TextBlock
                                        x:Name="DataFolderText"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CardHint}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="OpenDataFolder_Click"
                                    Content="Открыть" />
                            </Grid>
                        </Border>
                        <Button
                            Margin="0,12,0,0"
                            Click="Exit_Click"
                            Content="Закрыть островок" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
