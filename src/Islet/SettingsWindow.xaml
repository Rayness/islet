<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Islet.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Islet">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="Root"
        IsTabStop="True"
        Loaded="Root_Loaded"
        PreviewKeyDown="Root_PreviewKeyDown"
        RequestedTheme="Dark"
        UseSystemFocusVisuals="False">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,2" />
            </Style>
            <Style x:Key="PageStack" TargetType="StackPanel">
                <Setter Property="Spacing" Value="6" />
                <Setter Property="Padding" Value="36,8,36,36" />
                <Setter Property="MaxWidth" Value="900" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Свой заголовок окна: иконка и название, остальное — системные кнопки. -->
        <StackPanel
            x:Name="TitleBar"
            Padding="16,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <Image Width="18" Height="18" Source="ms-appx:///Assets/islet.ico" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                x:Uid="SettingsHeader" />
        </StackPanel>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavGeneral" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavBehavior" Tag="behavior">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavNotifications" Tag="notifications">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA8F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavLook" Tag="look">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSearch" Tag="search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPins" Tag="pins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE718;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavIntegrations" Tag="integrations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPlugins" Tag="plugins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAbout" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- ============ Общие ============ -->
                <ScrollViewer x:Name="GeneralPage">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" x:Uid="PageGeneral" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="HotkeyTitle" />
                                    <TextBlock
                                        x:Name="HotkeyStatusText"
                                        Style="{StaticResource CardHint}"
 />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Border
                                        Padding="10,5"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <TextBlock x:Name="HotkeyText" FontFamily="Consolas" />
                                    </Border>
                                    <Button x:Name="HotkeyButton" Click="HotkeyButton_Click" x:Uid="HotkeyButton" />
                                    <Button
                                        x:Name="HotkeyResetButton"
                                        Click="HotkeyResetButton_Click"
>
                                        <FontIcon FontSize="14" Glyph="&#xE777;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="AutoStartTitle" />
                                    <TextBlock Style="{StaticResource CardHint}" x:Uid="AutoStartHint" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoStartToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="AutoStartToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="WebSearchTitle" />
                                    <TextBlock Style="{StaticResource CardHint}" x:Uid="WebSearchHint" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="EngineCombo"
                                    Grid.Column="1"
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Title"
                                    SelectionChanged="EngineCombo_SelectionChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="LanguageTitle" />
                                    <TextBlock Style="{StaticResource CardHint}" x:Uid="LanguageHint" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="LanguageCombo"
                                    Grid.Column="1"
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    SelectionChanged="LanguageCombo_SelectionChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Поведение ============ -->
                <ScrollViewer x:Name="BehaviorPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" x:Uid="PageBehavior" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="HoverOpenTitle" />
                                    <TextBlock Style="{StaticResource CardHint}" x:Uid="HoverOpenHint" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="HoverOpenToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="HoverOpenToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="OpenDelayTitle" />
                                    <TextBlock
                                        x:Name="OpenDelayValue"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardHint}" />
                                </Grid>
                                <TextBlock Style="{StaticResource CardHint}" x:Uid="OpenDelayHint" />
                                <Slider
                                    x:Name="OpenDelaySlider"
                                    Maximum="1000"
                                    Minimum="0"
                                    StepFrequency="50"
                                    ValueChanged="OpenDelaySlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="CloseDelayTitle" />
                                    <TextBlock
                                        x:Name="CloseDelayValue"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardHint}" />
                                </Grid>
                                <TextBlock Style="{StaticResource CardHint}" x:Uid="CloseDelayHint" />
                                <Slider
                                    x:Name="CloseDelaySlider"
                                    Maximum="2000"
                                    Minimum="0"
                                    StepFrequency="50"
                                    ValueChanged="CloseDelaySlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="HideCollapsedTitle" />
                                    <TextBlock Style="{StaticResource CardHint}" x:Uid="HideCollapsedHint" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="HideCollapsedToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="HideCollapsedToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="FullscreenTitle" />
                                    <TextBlock Style="{StaticResource CardHint}" x:Uid="FullscreenHint" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="FullscreenToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="FullscreenToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="MonitorTitle" />
                                    <TextBlock Style="{StaticResource CardHint}" x:Uid="MonitorHint" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="MonitorCombo"
                                    Grid.Column="1"
                                    MinWidth="200"
                                    VerticalAlignment="Center"
                                    SelectionChanged="MonitorCombo_SelectionChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Внешний вид ============ -->
                <ScrollViewer x:Name="LookPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" x:Uid="PageLook" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="GlassTitle" />
                                    <TextBlock Style="{StaticResource CardHint}" x:Uid="GlassHint" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="GlassToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="GlassToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="SurfaceTitle" />
                                    <TextBlock
                                        x:Name="OpacityValue"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardHint}" />
                                </Grid>
                                <TextBlock Style="{StaticResource CardHint}" x:Uid="SurfaceHint" />
                                <Slider
                                    x:Name="OpacitySlider"
                                    Maximum="100"
                                    Minimum="20"
                                    StepFrequency="1"
                                    ValueChanged="OpacitySlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="WidthTitle" />
                                    <TextBlock
                                        x:Name="WidthValue"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardHint}" />
                                </Grid>
                                <Slider
                                    x:Name="WidthSlider"
                                    Maximum="960"
                                    Minimum="560"
                                    StepFrequency="20"
                                    ValueChanged="WidthSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="CollapsedWidthTitle" />
                                    <TextBlock
                                        x:Name="CollapsedWidthValue"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardHint}" />
                                </Grid>
                                <Slider
                                    x:Name="CollapsedWidthSlider"
                                    Maximum="400"
                                    Minimum="60"
                                    StepFrequency="10"
                                    ValueChanged="CollapsedWidthSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="CollapsedHeightTitle" />
                                    <TextBlock
                                        x:Name="CollapsedHeightValue"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardHint}" />
                                </Grid>
                                <Slider
                                    x:Name="CollapsedHeightSlider"
                                    Maximum="24"
                                    Minimum="3"
                                    StepFrequency="1"
                                    ValueChanged="CollapsedHeightSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="MaxRowsTitle" />
                                    <TextBlock
                                        x:Name="MaxRowsValue"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CardHint}" />
                                </Grid>
                                <TextBlock Style="{StaticResource CardHint}" x:Uid="MaxRowsHint" />
                                <Slider
                                    x:Name="MaxRowsSlider"
                                    Maximum="12"
                                    Minimum="3"
                                    StepFrequency="1"
                                    ValueChanged="MaxRowsSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CardTitle}"
                                    x:Uid="ClockToggle" />
                                <ToggleSwitch
                                    x:Name="ClockToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="ClockToggle_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Поиск ============ -->
                <ScrollViewer x:Name="SearchPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" x:Uid="PageSearch" />

                        <!-- Источники выдачи: калькулятор, команды, буфер, недавнее (собирается в коде). -->
                        <StackPanel x:Name="SearchSourcesStack" Spacing="6" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="DriveIndexTitle" />
                                    <TextBlock Style="{StaticResource CardHint}" x:Uid="DriveIndexHint" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="IndexToggle"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="IndexToggle_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="IndexStatusTitle" />
                                    <TextBlock x:Name="IndexStatusText" Style="{StaticResource CardHint}" />
                                </StackPanel>
                                <Button
                                    x:Name="RescanButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="RescanButton_Click"
                                    x:Uid="ReindexButton" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" x:Uid="RootsSection" />
                        <StackPanel x:Name="RootsPanel" Spacing="6" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="AddRoot_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock x:Uid="AddRootText" />
                                </StackPanel>
                            </Button>
                            <Button Click="ResetRoots_Click" x:Uid="ResetRootsButton" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Section}" x:Uid="ExcludesSection" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource CardHint}" x:Uid="ExcludesHint" />
                                <TextBox
                                    x:Name="ExcludesBox"
                                    MinHeight="120"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    TextWrapping="NoWrap" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="SaveExcludes_Click"
                                    x:Uid="SaveExcludesButton"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Section}" x:Uid="SystemDriveSection" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CardHint}" x:Uid="SystemDriveHint" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="OpenWindowsSearch_Click"
                                    x:Uid="OpenSearchSettingsButton" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Кнопки ============ -->
                <ScrollViewer x:Name="PinsPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" x:Uid="PagePins" />
                        <TextBlock Style="{StaticResource CardHint}" x:Uid="PinsHint" />

                        <StackPanel x:Name="PinsList" Margin="0,8,0,0" Spacing="6" />

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddPinButton" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock x:Uid="AddPinText" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Click="AddPinFile_Click" x:Uid="AddPinFile">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="AddPinFolder_Click" x:Uid="AddPinFolder">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="AddPinUrl_Click" x:Uid="AddPinUrl">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE71B;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Click="ResetPins_Click" x:Uid="ResetPinsButton" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ Уведомления, Интеграции, Плагины — собираются в коде ============ -->
                <ScrollViewer x:Name="NotificationsPage" Visibility="Collapsed">
                    <StackPanel x:Name="NotificationsStack" Style="{StaticResource PageStack}" />
                </ScrollViewer>
                <ScrollViewer x:Name="IntegrationsPage" Visibility="Collapsed">
                    <StackPanel x:Name="IntegrationsStack" Style="{StaticResource PageStack}" />
                </ScrollViewer>
                <ScrollViewer x:Name="PluginsPage" Visibility="Collapsed">
                    <StackPanel x:Name="PluginsStack" Style="{StaticResource PageStack}" />
                </ScrollViewer>

                <!-- ============ О программе ============ -->
                <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageStack}">
                        <TextBlock Style="{StaticResource PageTitle}" x:Uid="PageAbout" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Image Width="48" Height="48" Source="ms-appx:///Assets/islet.ico" />
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Islet" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource CardHint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource CardTitle}" x:Uid="DataFolderTitle" />
                                    <TextBlock
                                        x:Name="DataFolderText"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CardHint}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="OpenDataFolder_Click"
                                    x:Uid="OpenDataFolderButton" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource CardTitle}" x:Uid="UpdateTitle" />
                                        <TextBlock
                                            x:Name="UpdateStatusText"
                                            Style="{StaticResource CardHint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        x:Name="UpdateCheckButton"
                                        x:Uid="UpdateCheckButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="UpdateCheck_Click" />
                                </Grid>
                                <Button
                                    x:Name="UpdateApplyButton"
                                    HorizontalAlignment="Stretch"
                                    Click="UpdateApply_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Button
                            Margin="0,12,0,0"
                            Click="Exit_Click"
                            x:Uid="QuitButton" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
